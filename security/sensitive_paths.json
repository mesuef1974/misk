{
  "version": 1,
  "purpose": "مسارات تلزمها مراجعة بشرية قبل الدمج، ومسارات محظورة على الدمج الآلي مهما اخضرّت الفحوص. تُقرأ من فرع الأساس لا من رأس الطلب.",
  "forbidden_for_auto_merge": [
    "**/migrations/*",
    "config/settings/*",
    "**/permissions*",
    "**/rbac*",
    "**/auth*",
    "**/crypto*",
    "**/*upload*",
    "**/*export*",
    "docker-compose*.yml",
    "**/*payment*",
    "**/*billing*",
    "**/*invoice*",
    "**/*pricing*",
    "**/*refund*"
  ],
  "forbidden_for_auto_merge_content": {
    "money": {
      "paths": ["apps/*", "frontend/src/*"],
      "patterns": [
        "(?i)(price|amount|subtotal|total|discount|tax|vat|payment|invoice|refund|currency|deposit|balance)",
        "سعر|أسعار|مبلغ|إجمالي|خصم|ضريبة|دفعة|فاتورة|عربون|رصيد|ريال"
      ]
    }
  },
  "mandatory_review_when_diff_touches": {
    "authorization_identity": ["**/permissions*", "**/rbac*", "**/auth*", "config/settings/*"],
    "data_and_privacy": ["**/crypto*", "**/*export*", "**/*import*", "**/*upload*"],
    "deploy_and_ci": [".github/**", "Dockerfile", "railway.toml", "scripts/railway-*.sh", "scripts/*gate*.py", "scripts/approval.py"]
  },
  "mandatory_review_when_diff_content_matches": {
    "secrets_like": ["(?i)(secret|password|api[_-]?key|token)\\s*[=:]\\s*['\"][^'\"]{8,}"],
    "unsafe_django": ["mark_safe\\(", "\\.extra\\(", "RawSQL\\(", "csrf_exempt"]
  }
}
