# انسخه إلى .env للتطوير المحلي. لا يُرفع .env إلى git.
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-dev-only
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://misk:misk@localhost:5432/misk
REDIS_URL=redis://localhost:6379/0
ADMIN_URL=admin/
LOG_LEVEL=INFO

# في Railway: DATABASE_URL وREDIS_URL تأتيان من plugins عبر variable references،
# وتُضاف SECRET_KEY وALLOWED_HOSTS وCSRF_TRUSTED_ORIGINS في اللوحة (لا في railway.toml).
