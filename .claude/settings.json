{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_git.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_deploy.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)"
    ],
    "deny": [
      "Bash(railway *)",
      "Bash(*@railway/cli*)",
      "Bash(*merge_gate.py*--enable*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
